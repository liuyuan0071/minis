<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ Themed Icon monochrome counterpart to the AI work-assistant
  launcher icon. The system tints this drawable with the active
  monochromatic palette at runtime; we provide the silhouette in solid white.

  Canvas is the standard adaptive-icon 108dp x 108dp. Drawn as a single
  rounded-square path — the outer silhouette of the new AI-assistant icon
  (a rounded square emblem). Sizing keeps every point inside the circular
  mask (center (54,54), radius 33) plus half the stroke so themed icons
  don't clip on Pixel-class launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M 39,33 L 69,33 Q 75,33 75,39 L 75,69 Q 75,75 69,75 L 39,75 Q 33,75 33,69 L 33,39 Q 33,33 39,33 Z" />
</vector>
